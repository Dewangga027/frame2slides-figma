{
  "name": "frame2slides-figma",
  "version": "1.0.0",
  "description": "Figma plugin for editable PPTX and PDF export",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/plugin/main.ts --bundle --platform=browser --target=es2020 --format=iife --outfile=dist/plugin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dewangga027/frame2slides-figma.git"
  },
  "keywords": [],
