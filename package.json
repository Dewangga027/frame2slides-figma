  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Dewangga027/frame2slides-figma/issues"
  },
  "homepage": "https://github.com/Dewangga027/frame2slides-figma#readme",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "typescript": "^7.0.2",
    "upng-js": "^2.1.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  }
